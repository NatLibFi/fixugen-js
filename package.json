{
	"name": "@natlibfi/fixugen",
	"description": "Generate Node.js unit tests from fixtures and callbacks",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/fixugen",
	"bugs": {
		"url": "https://github.com/natlibfi/fixugen-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/fixugen-js"
	},
	"license": "MIT",
	"version": "3.0.1",
	"main": "./dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --experimental-test-coverage --test-reporter=spec './src/index.test.ts'",
		"test:only": "node --test-only --experimental-test-coverage --test-reporter=spec './src/index.only.test.ts'",
		"test": "npm run lint && npm run test:base && npm run test:only",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/*.test.ts' './src/**/*.test.ts' && node --test-only --experimental-test-coverage --test-reporter=spec './src/*.test.ts' './src/**/*.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"@natlibfi/fixura": "^5.0.0-alpha.3"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.0",
		"jiti": "^2.6.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1"
	}
}